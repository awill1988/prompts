root ::= "{" ws "\"evidence\"" ws ":" ws string ws "," ws "\"assessment\"" ws ":" ws string ws "," ws "\"disposition\"" ws ":" ws verdict ws "}"
verdict ::= "\"APPROVE\"" | "\"COMMENT\"" | "\"REQUEST_CHANGES\""
string ::= "\"" char+ "\""
char ::= [^"\\\x00-\x1F] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
ws ::= [ \t\n\r]*
